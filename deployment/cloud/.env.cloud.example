# Copy this to .env.cloud; never commit the copy.
ERP_DOMAIN=erp.example.com
# Runtime role, session-mode pooler on port 5432. Copy the EXACT host from
# Supabase Dashboard -> Connect -> Session pooler (the cluster index is
# per-project and not guessable). URL-encode reserved password characters.
SUPABASE_DATABASE_URL='postgresql://kayan_runtime.PROJECT_REF:URL_ENCODED_PASSWORD@aws-?-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full'
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARS
