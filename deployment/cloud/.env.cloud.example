# Copy this to .env.cloud; never commit the copy.
ERP_DOMAIN=erp.example.com
# Use the session-mode pooler on port 5432. URL-encode reserved characters.
SUPABASE_DATABASE_URL='postgresql://kayan_runtime.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full'
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARS
