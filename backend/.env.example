# Copy to .env and adjust. NEVER commit the real .env file.

# PostgreSQL connection. Local development default:
DATABASE_URL="postgresql://erp_app:CHANGE_ME@127.0.0.1:5432/erp_kayan?schema=public"

# API server
PORT=3000
NODE_ENV=development

# JWT signing secrets — generate with:  openssl rand -base64 48
# These MUST be different in every environment and must never be shared.
JWT_ACCESS_SECRET="replace-with-a-long-random-value"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-value"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# Comma-separated list of allowed browser origins (Flutter web dev server).
CORS_ORIGINS="http://localhost:8081,http://localhost:5173"
