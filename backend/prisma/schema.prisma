// KAYAN ERP — database schema
//
// Design rules enforced here:
//  * Money is DECIMAL(19,4) — never floating point.
//  * Every business row carries company_id so data can never leak across
//    companies; branch_id is an analytical dimension where relevant.
//  * Posted journal entries are append-only: corrections happen by inserting
//    a reversal, never by editing or deleting.
//  * Every table has created/updated audit fields and a soft-delete marker.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- tenancy

model Company {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  nameEn   String
  nameAr   String
  taxId    String? // Egyptian Tax Registration Number
  currency String @default("EGP") @db.VarChar(3)
  timezone String @default("Africa/Cairo")

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  branches      Branch[]
  users         User[]
  accounts      Account[]
  journalEntry  JournalEntry[]
  roles         Role[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]

  @@map("companies")
}

model Branch {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid
  code      String
  nameEn    String
  nameAr    String
  isActive  Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userBranches UserBranch[]
  journalEntry JournalEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

// ------------------------------------------------------- users & security

model User {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  username     String    @unique
  email        String?   @unique
  fullNameEn   String
  fullNameAr   String
  passwordHash String // Argon2id. Never stores a plain or reversible value.
  isActive     Boolean   @default(true)
  isSuperAdmin Boolean   @default(false)

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  branches     UserBranch[]
  refreshToken RefreshToken[]
  auditLogs    AuditLog[]
  journalEntry JournalEntry[]   @relation("JournalCreatedBy")

  @@index([companyId])
  @@map("users")
}

model Role {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String? @db.Uuid // null = system role available to all companies
  code      String
  nameEn    String
  nameAr    String
  isSystem  Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique // e.g. "accounting.journal.post"
  nameEn   String
  nameAr   String
  module   String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String  @db.Uuid
  roleId    String  @db.Uuid
  companyId String  @db.Uuid
  branchId  String? @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, companyId])
  @@index([userId])
  @@map("user_roles")
}

model UserBranch {
  userId   String @db.Uuid
  branchId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

/// Refresh tokens are stored hashed so a database leak cannot be replayed.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------- accounting

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  code        String
  nameEn      String
  nameAr      String
  type        AccountType
  parentId    String?     @db.Uuid
  isPostable  Boolean     @default(true)
  isActive    Boolean     @default(true)
  currency    String?     @db.VarChar(3)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   Account? @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Account[] @relation("AccountTree")
  lines    JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, type])
  @@index([parentId])
  @@map("accounts")
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @db.Uuid
  branchId    String        @db.Uuid
  entryNumber String
  entryDate   DateTime      @db.Date
  description String?
  status      JournalStatus @default(DRAFT)
  currency    String        @default("EGP") @db.VarChar(3)

  /// Total debits and credits are stored denormalised so reports never have
  /// to re-aggregate the lines, and a database constraint can assert balance.
  totalDebit  Decimal       @db.Decimal(19, 4)
  totalCredit Decimal       @db.Decimal(19, 4)

  reversalOfId String?   @db.Uuid
  postedAt     DateTime?
  postedBy     String?   @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?   @db.Uuid

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdByUser User?       @relation("JournalCreatedBy", fields: [createdBy], references: [id])
  reversalOf JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals  JournalEntry[] @relation("Reversal")
  lines      JournalLine[]

  @@unique([companyId, entryNumber])
  @@index([companyId, entryDate])
  @@index([companyId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @db.Uuid
  lineNumber     Int
  accountId      String  @db.Uuid
  debit          Decimal @default(0) @db.Decimal(19, 4)
  credit         Decimal @default(0) @db.Decimal(19, 4)
  description    String?
  costCenterId   String? @db.Uuid

  entry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId])
  @@map("journal_lines")
}

// ------------------------------------------------------- document numbering

/// Authoritative document numbering.
///
/// Numbers are allocated by the server inside the same transaction that
/// creates the document, so two users can never receive the same number.
/// Allocation takes a row lock on the counter, which serialises concurrent
/// requests for the same company and document type.
///
/// REQUIRES BUSINESS DECISION: whether numbering must be gapless (a legal
/// requirement in some jurisdictions), and whether it restarts each fiscal
/// year. The current implementation increments per company without gaps in
/// normal operation, but a rolled-back transaction still consumes a number.
model DocumentSequence {
  companyId String @db.Uuid
  key       String @db.VarChar(40) // e.g. JOURNAL
  prefix    String @db.VarChar(10) @default("DOC")
  nextValue Int    @default(1)

  updatedAt DateTime @updatedAt

  @@id([companyId, key])
  @@map("document_sequences")
}

// ------------------------------------------------------------- audit trail

/// Append-only. Rows are never updated or deleted by application code.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String?  @db.Uuid
  userId     String?  @db.Uuid
  action     String // CREATE / UPDATE / POST / LOGIN / LOGIN_FAILED ...
  entity     String // table or aggregate name
  entityId   String?
  beforeJson Json?
  afterJson  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
