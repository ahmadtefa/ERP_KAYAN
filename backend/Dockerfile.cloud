# Cloud-only NestJS + Flutter Web image. Build context: backend/.
# Copy the repository's Flutter build/web output to backend/build/web first.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json nest-cli.json ./
COPY src ./src
COPY build/web ./build/web
RUN npx prisma generate && npx prisma validate && npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV KAYAN_WEB_ROOT=/app/build/web
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/build/web ./build/web
USER node
EXPOSE 3000
CMD ["node", "dist/src/main.js"]
